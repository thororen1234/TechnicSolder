APP_NAME="Technic Solder"
APP_ENV=production
# Generate with `pnpm solder key:generate`. Keep the key of an existing install: it decrypts two-factor secrets.
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
# Port the web server listens on
PORT=3000

APP_TIMEZONE=UTC
BCRYPT_ROUNDS=12

# mysql (also MariaDB), pgsql or sqlite (DB_DATABASE is then a file path, such as storage/solder.sqlite)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=solder
DB_USERNAME=root
DB_PASSWORD=

# "redis" shares the cache and sessions between the web, worker and scheduler processes; anything else keeps them in memory
CACHE_STORE=memory
SESSION_DRIVER=memory
SESSION_LIFETIME=120
# "sync" runs modpack imports, exports and update checks inside the web request.
# Set to "redis" and run `pnpm worker` to run them in the background.
QUEUE_CONNECTION=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Set MAIL_ENABLED=true to enable password reset via email
MAIL_ENABLED=false
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="Technic Solder"

SOLDER_CORS_ORIGINS=*

# Show advanced UI settings, including Mojang Java runtime overrides
SOLDER_ADVANCED_MODE=false

# Initial admin user for `pnpm solder setup` (non-interactive mode only)
# SOLDER_INITIAL_ADMIN_EMAIL=admin@admin.com
# SOLDER_INITIAL_ADMIN_PASSWORD=

SOLDER_REPO_LOCATION=/var/www/mods.solder.test/
SOLDER_MIRROR_URL=http://mods.solder.test/
SOLDER_MD5_CONNECT_TIMEOUT=5
SOLDER_MD5_FILE_TIMEOUT=30

# Required to import mods and modpacks from CurseForge (https://console.curseforge.com/)
CURSEFORGE_API_KEY=

# Post update checks, finished imports, published builds and repository problems to Discord
SOLDER_DISCORD_WEBHOOK=
# ...or send them as direct messages: a bot token, and the user IDs (comma-separated) the bot shares a server with
SOLDER_DISCORD_BOT_TOKEN=
SOLDER_DISCORD_USER_ID=
# Check every modpack's latest build for mod updates each night (requires `pnpm scheduler`)
SOLDER_SCHEDULED_UPDATE_CHECKS=true
