{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "technic-solder",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm run build:server",
    "build:server": "pnpm run prisma:generate && tsc -p tsconfig.build.json",
    "prisma:generate": "node scripts/prisma-generate.mjs",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "worker": "node dist/worker.js",
    "scheduler": "node dist/scheduler.js",
    "solder": "node dist/cli.js",
    "solder:dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "packageManager": "pnpm@12.14.0",
  "dependencies": {
    "@alpinejs/collapse": "^3.17.4",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tailwindcss/forms": "^0.5.11",
    "adm-zip": "^0.6.1",
    "alpinejs": "^3.17.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^6.3.15",
    "connect-redis": "^10.0.0",
    "dotenv": "^18.0.8",
    "eta": "^4.6.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "ioredis": "^6.0.0",
    "knex": "^3.3.0",
    "mariadb": "^3.5.4",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@tailwindcss/vite": "4.3.3",
    "@types/adm-zip": "^0.6.0",
    "@types/alpinejs": "^3.17.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  }
}
