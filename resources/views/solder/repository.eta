<% const __sections = {}; const __capture = [] %>
<% __capture.push(['title', __eta.res]); __eta.res = '' %>
    <title>Mod Repository - Technic Solder</title>
<% { const [__name, __prev, __append] = __capture.pop(); __sections[__name] = (__append ? (__sections?.[__name] ?? '') : '') + __eta.res; __eta.res = __prev } %>
<% __capture.push(['content', __eta.res]); __eta.res = '' %>
    <div class="page-header">
        <div>
            <h1 class="page-title">Mod repository</h1>
            <p class="page-subtitle">Check that every mod version's file exists and matches its stored checksum.</p>
        </div>
        <form method="POST" action="<%= route('solder.repository') %>">
            <%~ csrfField() %>
            <button type="submit" class="ui-btn ui-btn-primary"><%= task ? 'Check again' : 'Run check' %></button>
        </form>
    </div>

    <% if (session('success')) { const value = session('success') %>
        <div class="ui-alert ui-alert-success mb-6 p-4"><%= value %></div>
    <% } %>
    <%~ include('/partial/form-errors', it) %>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
        <div class="ui-stat sm:col-span-2">
            <p class="ui-stat-label">Location (<%= isRemote ? 'remote URL' : 'local folder' %>)</p>
            <p class="mt-1.5 font-mono text-sm text-gray-950 dark:text-white truncate" title="<%= location %>"><%= location %></p>
        </div>
        <div class="ui-stat">
            <p class="ui-stat-label">Mod versions</p>
            <p class="ui-stat-value"><%= number_format(modversionCount) %></p>
        </div>
    </div>

    <% if (task === null) { %>
        <div class="ui-card border-dashed px-6 py-14 text-center">
            <p class="text-sm font-medium text-gray-950 dark:text-white">No check has been run yet</p>
            <p class="mt-1 text-sm text-gray-500">
                The check reads every file<%= isRemote ? ' over HTTP' : '' %>, so it can take a while for large repositories.
            </p>
        </div>
    <% } else if (task['status'] !== 'completed') { %>
        <div class="ui-card p-6 text-sm text-gray-600 dark:text-gray-400">
            <%= task['message'] %> <a href="<%= route('task.show', task['id']) %>" class="underline">Follow progress</a>
        </div>
    <% } else { %>
        <% const problems = collect(task['result']['problems']) %>
        <section class="ui-card overflow-hidden" x-data="{ selected: [] }">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-5 py-3.5 border-b border-gray-200 dark:border-gray-800">
                <h2 class="section-title flex items-center gap-2">
                    <% if (problems.isEmpty()) { %>
                        <span class="size-2 rounded-full bg-emerald-500"></span>
                    <% } else { %>
                        <span class="size-2 rounded-full bg-amber-500"></span>
                    <% } %>
                    <%= task['result']['message'] %>
                </h2>
                <span class="text-xs text-gray-500">Checked <%= carbonFromTimestamp(task['updated_at']).diffForHumans() %></span>
            </div>

            <% if (problems.isNotEmpty()) { %>
                <form method="POST" action="<%= route('solder.repository.fix') %>">
                    <%~ csrfField() %>
                    <input type="hidden" name="task" value="<%= task['id'] %>">
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="ui-table-head">
                                    <th class="pl-5 pr-2 py-3 w-8"><span class="sr-only">Select</span></th>
                                    <th class="px-3 py-3">Mod</th>
                                    <th class="px-3 py-3">Problem</th>
                                    <th class="px-5 py-3 hidden md:table-cell">File</th>
                                </tr>
                            </thead>
                            <tbody class="ui-table-body">
                                <% for (const problem of (problems ?? [])) { %>
                                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-900/50">
                                        <td class="pl-5 pr-2 py-2.5">
                                            <% if (problem['problem'] === 'changed') { %>
                                                <input type="checkbox" name="modversions[]" value="<%= problem['modversion_id'] %>" x-model="selected" class="ui-checkbox"
                                                       aria-label="Select <%= problem['mod'] %> <%= problem['version'] %>">
                                            <% } %>
                                        </td>
                                        <td class="px-3 py-2.5">
                                            <a href="<%= url('mod/view/' + problem['mod_id']) %>" class="font-medium text-gray-950 dark:text-white hover:underline underline-offset-2"><%= problem['mod'] %></a>
                                            <span class="ml-1 font-mono text-xs text-gray-500"><%= problem['version'] %></span>
                                        </td>
                                        <td class="px-3 py-2.5">
                                            <span class="<%= classes({0:'ui-badge','ui-badge-warning': problem['problem'] === 'changed','text-red-600! dark:text-red-400!': problem['problem'] === 'missing'}) %>">
                                                <%= problem['problem'] === 'missing' ? 'Missing' : 'Changed' %>
                                            </span>
                                            <span class="ml-2 text-xs text-gray-500"><%= problem['message'] %></span>
                                        </td>
                                        <td class="px-5 py-2.5 font-mono text-xs text-gray-500 hidden md:table-cell"><%= problem['path'] %></td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    <div class="flex items-center justify-between gap-3 px-5 py-3 border-t border-gray-200 dark:border-gray-800">
                        <p class="text-xs text-gray-500">
                            Changed files may have been replaced on purpose. Updating the stored checksum makes the launcher accept the new file.
                            Missing files need to be uploaded again.
                        </p>
                        <button type="submit" class="ui-btn ui-btn-secondary shrink-0" :disabled="!selected.length"
                                x-text="'Update ' + selected.length + ' checksum' + (selected.length === 1 ? '' : 's')">Update checksums</button>
                    </div>
                </form>
            <% } %>
        </section>
    <% } %>
<% { const [__name, __prev, __append] = __capture.pop(); __sections[__name] = (__append ? (__sections?.[__name] ?? '') : '') + __eta.res; __eta.res = __prev } %>

<% layout('/layouts/master', { ...it, __sections }) %>
