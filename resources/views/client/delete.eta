<% const __sections = {}; const __capture = [] %>
<% __capture.push(['title', __eta.res]); __eta.res = '' %>
    <title>Client Management - Technic Solder</title>
<% { const [__name, __prev, __append] = __capture.pop(); __sections[__name] = (__append ? (__sections?.[__name] ?? '') : '') + __eta.res; __eta.res = __prev } %>
<% __capture.push(['content', __eta.res]); __eta.res = '' %>
    <h1 class="text-2xl font-bold">Client Management</h1>

    <div class="ui-card mt-6">
        <div class="ui-card-header">
            <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">Delete Client (<%= client.name %>)</h2>
        </div>
        <div class="px-5 py-4">
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
                This will immediately remove access to all modpacks this user has access to.
            </p>

            <form method="post" action="<%= currentUrl() %>" accept-charset="UTF-8">
                <%~ csrfField() %>
                <div class="flex items-center gap-3">
                    <button type="submit"
                            class="ui-btn ui-btn-danger">
                        Confirm Deletion
                    </button>
                    <a href="<%= url('/client/list') %>"
                       class="ui-btn ui-btn-secondary">
                        Go Back
                    </a>
                </div>
            </form>
        </div>
    </div>
<% { const [__name, __prev, __append] = __capture.pop(); __sections[__name] = (__append ? (__sections?.[__name] ?? '') : '') + __eta.res; __eta.res = __prev } %>

<% layout('/layouts/master', { ...it, __sections }) %>
